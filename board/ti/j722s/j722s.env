#include <env/ti/ti_common.env>
#include <env/ti/mmc.env>
#include <env/ti/k3_dfu.env>

#if CONFIG_CMD_REMOTEPROC
#include <env/ti/k3_rproc.env>
#endif

name_kern=Image
console=ttyS2,115200n8
boot_partition=a
args_all=
	setenv optargs earlycon=ns16550a,mmio32,0x02850000 mitigations=off rootwait=1 quiet;
	gpio read D23 gpio@601000_26;
	gpio read P23 gpio@600000_44;
	if test ${P23} = 0; then;
		if test ${D23} = 0; then;
			setenv fdtfile ti/k3-j722s-altos-v4.dtb;
			setenv fwpath firmware_class.path=/opt/radar/firmware/v4;
		else
			setenv fdtfile ti/k3-j722s-altos-rcu-v1.dtb;
			setenv fwpath firmware_class.path=/opt/radar/firmware/v4;
		fi;
	else
		setenv fdtfile ti/k3-j722s-altos-v3.dtb;
		setenv fwpath firmware_class.path=/opt/radar/firmware/v3;
	fi
args_mmc=setenv bootargs console=${console} ${optargs} ${fwpath} root=PARTLABEL=rootfs.${boot_partition} rootfstype=ext4 init=/sbin/preinit ro
altbootcmd=
	if test ${boot_partition} = a; then;
		setenv boot_partition b;
	else
		setenv boot_partition a;
	fi;
	setenv upgrade_available 0;
	env save;
	run bootcmd
run_kern=booti ${loadaddr} ${rd_spec} ${fdtaddr}

boot_targets=mmc1 mmc0 pxe dhcp
boot=mmc
mmcdev=0
bootpart=0
bootdir=/boot
rd_spec=-

name_overlays=ti/k3-j722s-edgeai-apps.dtbo

rproc_fw_binaries= 0 /lib/firmware/j722s-mcu-r5f0_0-fw 2 /lib/firmware/j722s-main-r5f0_0-fw 3 /lib/firmware/j722s-c71_0-fw 4 /lib/firmware/j722s-c71_1-fw
